#!/bin/sh
set -o errexit
set -o nounset

echo "[startup] Verifying durable SQLite state before migrations..."
python manage.py dbsnapshot_prepare_startup

db_engine="$(python -c 'import json,os; raw=os.getenv("DB_CREDENTIALS"); print((json.loads(raw).get("DB_ENGINE") if raw else os.getenv("DB_ENGINE")) or "django.db.backends.postgresql")')"
case "$db_engine" in
    sqlite|sqlite3|django.db.backends.sqlite3) ;;
    *)
        echo "[startup] Waiting for PostgreSQL..."
        python /wait_for_postgres.py
        ;;
esac

echo "[startup] Applying pending migrations behind the database lock..."
python manage.py migrate_with_db_lock --noinput

echo "[startup] Database schema is ready."
