{
  "version": 1,
  "technologies": ["python", "django", "react", "typescript", "i18next", "tailwind_dark"],
  "warnings_as_errors": true,
  "max_file_bytes": 1048576,
  "warn_source_lines": 500,
  "max_source_lines": 1000,
  "warn_added_lines": 300,
  "primary_locale": "en",
  "exclude": [
    "**/migrations/*.py",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/generated/**",
    "**/*.min.js",
    "**/*.min.css",
    "**/package-lock.json",
    "**/npm-shrinkwrap.json",
    "**/uv.lock"
  ],
  "exceptions": []
}
